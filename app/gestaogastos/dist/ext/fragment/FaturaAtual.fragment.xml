<core:FragmentDefinition
    id="TESTE"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:form="sap.ui.layout.form"
>
    <VBox
        id="FaturaAtualVBoxCartao"
        core:require="{ handler: 'apps/dflc/gestaogastos/ext/fragment/FaturaAtual'}"
    >
        <!-- Painel para Detalhes da Fatura -->
        <Panel
            id="PainelFaturaCartao"
            headerText="Detalhes da Fatura"
            width="100%"
        >
            <content>
                <form:SimpleForm
                    id="idFaturaFormCartao"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    labelSpanL="4"
                    labelSpanM="3"
                    emptySpanL="0"
                    emptySpanM="0"
                    columnsL="1"
                    columnsM="1"
                >
                    <Label
                        id="_IDGenLabel"
                        text="Ano"
                    />
                    <Text
                        id="_IDGenText13"
                        text="{Ano}"
                    />

                    <Label
                        id="_IDGenLabel1"
                        text="Mês"
                    />
                    <Text
                        id="_IDGenText14"
                        text="{Mes}"
                    />

                    <Label
                        id="_IDGenLabel14"
                        text="Descrição"
                    />
                    <Text
                        id="_IDGenText15"
                        text="{Descricao}"
                    />

                    <Label
                        id="_IDGenLabel3"
                        text="Valor Total"
                    />
                    <ObjectNumber
                        id="_IDGenObjectNumber"
                        number="{ValorTotal}"
                        unit="{Moeda_code}"
                    />

                    <Label
                        visible="false"
                        text="Cartao_ID"
                    />
                    <Text
                        visible="false"
                        text="{Cartao_ID}"
                    />
                </form:SimpleForm>
            </content>
        </Panel>

        <!-- Painel para Tabela de Transações -->
        <Panel
            id="PainelTransacoesCartao"
            headerText="Transações da Fatura"
            width="100%"
        >
            <content>
                <Table
                    id="transactionsTableCartao"
                    inset="false"
                    mode="SingleSelect"
                    noDataText="Nenhuma transação encontrada"
                    growing="true"
                    growingScrollToLoad="false"
                    growingThreshold="10"
                    width="auto"
                    items="{ path: 'Transacoes'}"
                >
                    <headerToolbar>
                        <OverflowToolbar id="_IDGenOverflowToolbar1">
                            <SearchField
                                id="_IDGenSearchField"
                                search="handler.pesquisarTransacao"
                                width="auto"
                            />
                            <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                            <Button
                                icon="sap-icon://nav-back"
                                press="handler.retrocederFatura"
                            />
                            <Button
                                icon="sap-icon://navigation-right-arrow"
                                press="handler.avancarFatura"
                            />
                            <ToolbarSpacer id="_IDGenToolbarSpacer2" />
                            <Button
                                text="Mudar Categoria"
                                press="handler.mudarCategoria"
                            />
                            <Button
                                id="_IDGenButton5"
                                text="Excluir"
                                press="handler.excluirTransacao"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column>
                            <Text text="" />
                        </Column>
                        <Column id="_IDGenColumn7">
                            <Text
                                id="_IDGenText5"
                                text="Data"
                            />
                        </Column>
                        <Column id="_IDGenColumn2">
                            <Text
                                id="_IDGenText6"
                                text="Valor"
                            />
                        </Column>
                        <Column id="_IDGenColumn3">
                            <Text
                                id="_IDGenText7"
                                text="Parcelas"
                            />
                        </Column>
                        <Column id="_IDGenColumn4">
                            <Text
                                id="_IDGenText8"
                                text="Descrição"
                            />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem1">
                            <cells>
                                <Avatar
                                    src="{path:'Categoria/Imagem'}"
                                    displaySize="XS"
                                    badgeTooltip=""
                                />
                                <Text
                                    id="_IDGenText10"
                                    text="{Data}"
                                />
                                <ObjectNumber
                                    id="_IDGenObjectNumber1"
                                    number="{Valor}"
                                    unit="{Moeda_code}"
                                />
                                <Text
                                    id="_IDGenText11"
                                    text="{Parcela} de {ParcelasTotais}"
                                />
                                <Text
                                    id="_IDGenText12"
                                    text="{Descricao}"
                                />
                                <Text
                                    id="IdTransacao"
                                    text="{ID}"
                                    visible="false"
                                />
                                <Text
                                    id="IdentificadorTransacao"
                                    text="{Identificador}"
                                    visible="false"
                                />
                                <Text
                                    id="CategoriaTransacao"
                                    text="{Categoria_ID}"
                                    visible="false"
                                />

                                <Text
                                    text="{ValorTotal}"
                                    visible="false"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </content>
        </Panel>
        <Panel
            id="PainelSemFaturaCartao"
            headerText="Sem Fatura Atual"
            width="100%"
        >
            <content>
                <VBox>
                    <HBox>
                        <Button
                            icon="sap-icon://nav-back"
                            press="handler.retrocederFatura"
                        />
                        <Button
                            icon="sap-icon://navigation-right-arrow"
                            press="handler.avancarFatura"
                        />
                    </HBox>
                    <Text
                        text="Caso seja adicionado gastos recarregue a página."
                    />
                </VBox>
            </content>
        </Panel>
    </VBox>
</core:FragmentDefinition>
