<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:macros="sap.fe.macros"
    xmlns:table="sap.ui.table"
    xmlns:form="sap.ui.layout.form"
>
    <VBox
        id="FaturaCompletaVBoxPessoa"
        fitContainer="true"
        core:require="{ handler: 'apps/dflc/gestaogastos/ext/fragment/DetalhamentoFaturaCompleta'}"
    >
        <!-- Painel para Detalhes da Fatura -->
        <Panel
            id="PainelFaturaPessoa"
            headerText="Detalhes da Fatura"
            width="100%"
        >
            <content>
                <form:SimpleForm
                    id="idFaturaFormPessoa"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    labelSpanL="4"
                    labelSpanM="3"
                    emptySpanL="0"
                    emptySpanM="0"
                    columnsL="1"
                    columnsM="1"
                >
                    <Label text="Ano" />
                    <Text text="{/Ano}" />

                    <Label text="Mês" />
                    <Text text="{/Mes}" />

                    <Label text="Descrição" />
                    <Text text="{/DescricaoFatura}" />

                    <Label text="Valor Total" />
                    <ObjectNumber
                        number="{/ValorTotal}"
                        unit="{/Moeda_code}"
                    />
                </form:SimpleForm>
            </content>
        </Panel>

        <!-- Painel para Tabela de Transações -->
        <Panel
            id="PainelTransacoesPessoa"
            headerText="Transações da Fatura"
            width="100%"
        >
            <content>
                <Table
                    id="transactionsDetailsTablePessoa"
                    inset="false"
                    mode="SingleSelect"
                    noDataText="Nenhuma transação encontrada"
                    growing="true"
                    growingScrollToLoad="false"
                    growingThreshold="10"
                    width="auto"
                    items="{ path: '/Transacoes'}"
                >
                    <headerToolbar>
                        <OverflowToolbar>
                            <SearchField
                                search="handler.pesquisarTransacao"
                                width="auto"
                            />
                            <ToolbarSpacer />
                            <Button
                                icon="sap-icon://nav-back"
                                press="handler.retrocederFatura"
                            />
                            <Button
                                icon="sap-icon://navigation-right-arrow"
                                press="handler.avancarFatura"
                            />
                            <ToolbarSpacer />
                            <Button
                                text="Mudar Categoria"
                                press="handler.mudarCategoria"
                            />
                            <Button
                                text="Excluir"
                                press="handler.excluirTransacao"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column
                            width="3rem"
                            demandPopin="false"
                            minScreenWidth="Tablet"
                        >
                            <Text text="Ct" />
                        </Column>
                        <Column
                            width="3rem"
                            demandPopin="false"
                            minScreenWidth="Tablet"
                        >
                            <Text text="Ctg" />
                        </Column>
                        <Column>
                            <Text text="Data" />
                        </Column>
                        <Column>
                            <Text text="Valor" />
                        </Column>
                        <Column>
                            <Text text="Parcelas" />
                        </Column>
                        <Column>
                            <Text text="Descrição" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Avatar
                                    src="{ path:'ImagemCartao' }"
                                    displaySize="XS"
                                    badgeTooltip=""
                                />

                                <Avatar
                                    src="{ path:'ImagemCategoria' }"
                                    displaySize="XS"
                                    badgeTooltip=""
                                />

                                <Text
                                    text="{
                                            path: 'Data',
                                            formatter: 'handler.formatter.formatDate'
                                    }"
                                />
                                <ObjectNumber
                                    number="{Valor}"
                                    unit="{Moeda_code}"
                                />
                                <Text text="{Parcela} de {ParcelasTotais}" />
                                <Text text="{Descricao}" />
                                <Text
                                    id="IdTransacaoPessoa"
                                    text="{ID}"
                                    visible="false"
                                />
                                <Text
                                    id="IdentificadorTransacaoPessoa"
                                    text="{Identificador}"
                                    visible="false"
                                />
                                <Text
                                    id="CategoriaTransacaoPessoa"
                                    text="{Categoria_ID}"
                                    visible="false"
                                />

                                <Text
                                    text="{ValorTotal}"
                                    visible="false"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </content>
        </Panel>

        <Panel
            id="PainelSemFaturaPessoa"
            headerText="Sem Fatura Atual"
            width="100%"
        >
            <content>
                <VBox>
                    <HBox>
                        <Button
                            icon="sap-icon://nav-back"
                            press="handler.retrocederFatura"
                        />
                        <Button
                            icon="sap-icon://navigation-right-arrow"
                            press="handler.avancarFatura"
                        />
                    </HBox>
                    <Text
                        text="Caso seja adicionado gastos recarregue a página."
                    />
                </VBox>
            </content>
        </Panel>
    </VBox>
</core:FragmentDefinition>
